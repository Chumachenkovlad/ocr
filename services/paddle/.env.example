# OCR Paddle Service — Environment Variables
# Copy to .env and adjust values as needed.

# Rendering DPI for PDFs (72–600)
OCR_DPI=300

# Maximum upload file size in megabytes
OCR_MAX_FILE_SIZE_MB=50

# Maximum pages to process per request
OCR_MAX_PAGES=100

# Inference device: "cpu" or "gpu"
OCR_DEVICE=cpu

# Default processing mode: "ocr" (text only) or "structure" (layout + text)
OCR_MODE=structure

# Per-request timeout in seconds
OCR_REQUEST_TIMEOUT_S=120

# Maximum concurrent OCR operations
OCR_MAX_CONCURRENT=4

# Logging level: DEBUG, INFO, WARNING, ERROR
OCR_LOG_LEVEL=INFO

# Custom model directory (models baked into Docker by default)
OCR_MODEL_DIR=/models

# Default recognition language ("auto" for auto-detect)
OCR_LANG=auto

# Server bind address
OCR_HOST=0.0.0.0
OCR_PORT=8080
